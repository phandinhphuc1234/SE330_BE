# -- App -------------------------------------------------
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
ENABLE_API_DOCS=false
RAG_INTERNAL_API_KEY=replace-with-a-long-random-service-secret

# -- Database --------------------------------------------
POSTGRES_DB=rag_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
RAG_POSTGRES_PORT=5433
POSTGRES_URL=postgresql+asyncpg://user:password@postgres:5432/rag_db
POSTGRES_URL_SYNC=postgresql://user:password@postgres:5432/rag_db

# -- Redis -----------------------------------------------
RAG_REDIS_PORT=6380
REDIS_URL=redis://redis:6379/0

# -- Celery ----------------------------------------------
# Defaults can point to Redis in development. In production, RabbitMQ can replace
# CELERY_BROKER_URL while Redis remains useful as result backend/cache.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# -- Vector Store ----------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=rag_chunks

# -- Embedding -------------------------------------------
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=3072
EMBEDDING_FALLBACK_MODEL=gemini-embedding-001
EMBEDDING_VERSION=gemini-embedding-2-3072-v1
EMBEDDING_TEXT_POLICY=gemini_search_title_text_v1
# Every chunk is a separate Gemini Content; HTTP requests group up to 8 chunks.
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_RETRIES=5
EMBEDDING_RETRY_BASE_DELAY_SECONDS=2
EMBEDDING_RETRY_MAX_DELAY_SECONDS=60
EMBEDDING_RETRY_JITTER_SECONDS=0.5
EMBEDDING_DISTANCE_METRIC=Cosine

# -- LLM --------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
GEMINI_API_KEY=

# -- Storage ---------------------------------------------
STORAGE_BACKEND=s3
STORAGE_LOCAL_PATH=./data/uploads
# STORAGE_LOCAL_PATH is only used when STORAGE_BACKEND=local.
# The default development flow writes raw uploads to SeaweedFS through
# the S3-compatible adapter below.
OBJECT_STORAGE_ENDPOINT=http://seaweedfs:8333
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=admin
OBJECT_STORAGE_SECRET_KEY=secret
LIBRARY_EBOOK_BUCKET=library-private
LIBRARY_TEMP_BUCKET=library-temp
RAG_ARTIFACT_BUCKET=rag-artifacts
# Deprecated compatibility alias. Do not provision a separate rag-source bucket.
RAG_SOURCE_BUCKET=library-private

# -- Ingestion -------------------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_CHUNKS_PER_DOCUMENT=1000
MAX_PDF_PAGES=3000
PDF_TEXT_SAMPLE_PAGES=5
PDF_MIN_AVG_TEXT_CHARS=50
MAX_UPLOAD_SIZE_MB=25
INGESTION_ALLOWED_EXTENSIONS=[".pdf"]
PDF_PARSER=pymupdf4llm
PDF_CLEANING_VERSION=pdf-clean-v1.0.0
PDF_CLEAN_NORMALIZE_UNICODE=true
PDF_CLEAN_COLLAPSE_SPACES=true
PDF_CLEAN_MAX_BLANK_LINES=2
# Step 9A: detect/report repeated header/footer candidates only; no removal yet.
PDF_CLEAN_HEADER_FOOTER_DETECTION_ENABLED=true
PDF_CLEAN_HEADER_FOOTER_TOP_LINES=3
PDF_CLEAN_HEADER_FOOTER_BOTTOM_LINES=3
PDF_CLEAN_HEADER_FOOTER_MIN_REPEAT_RATIO=0.4
# Step 9B: keep false until repeated candidates have been inspected on real PDFs.
PDF_CLEAN_HEADER_FOOTER_REMOVAL_ENABLED=false

# -- Retrieval -------------------------------------------
RETRIEVAL_TOP_K=10
RERANKER_TOP_K=3
HYBRID_VECTOR_WEIGHT=0.7
HYBRID_KEYWORD_WEIGHT=0.3

# -- Observability ---------------------------------------
# compose.observability.yml only adds the RAG Postgres and Redis exporters.
# Prometheus/Grafana belong to the backend stack. API /metrics remains a future step.

# -- Published host ports (container-to-container traffic uses service ports) --
RAG_API_PORT=8000
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_VOLUME_PORT=18080
