# Copy this file to .env for local development, then fill real values.
# Do not commit real secrets.

# PostgreSQL
LIBRARY_BIND_ADDRESS=127.0.0.1
LIBRARY_APP_PORT=8080
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
# Use a long random value in real environments.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters

# HMAC secret for ebook reading-session token hashes.
# In production, keep this separate from JWT_SECRET and rotate via a planned process.
EBOOK_READING_SESSION_SECRET=change-me-to-another-long-random-secret
EBOOK_AI_RATE_LIMIT_ENABLED=true
EBOOK_AI_ASK_REQUESTS_PER_WINDOW=10
EBOOK_AI_SEARCH_REQUESTS_PER_WINDOW=30
EBOOK_AI_RATE_LIMIT_WINDOW=1m
EBOOK_AI_RATE_LIMIT_FAIL_OPEN=false

# Mail / Resend SMTP and HTTP API
# RESEND_API_KEY starts with re_. Do not commit the real value.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# Free Resend testing commonly uses onboarding@resend.dev.
# With a verified domain, use no-reply@your-domain.com instead.
APP_TIME_ZONE=Asia/Ho_Chi_Minh
MAIL_FROM=onboarding@resend.dev
# Disabled for local development; deploy/runtime.env.example enables production delivery.
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_DELIVERY_BATCH_SIZE=10
NOTIFICATION_DELIVERY_POLL_DELAY_MS=5000
NOTIFICATION_DELIVERY_INITIAL_DELAY_MS=10000
NOTIFICATION_DELIVERY_LOCK_TIMEOUT=2m
NOTIFICATION_DELIVERY_INITIAL_RETRY_DELAY=30s
NOTIFICATION_DELIVERY_MAX_RETRY_DELAY=30m
NOTIFICATION_DELIVERY_CONNECT_TIMEOUT=5s
NOTIFICATION_DELIVERY_READ_TIMEOUT=15s
RESEND_WEBHOOK_ENABLED=false
RESEND_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxx
RESEND_WEBHOOK_MAX_PAYLOAD_BYTES=262144

# Frontend route embedded in password-reset emails. Keep this on the browser-facing origin.
APP_PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password
# One-time reset-token lifetime in minutes.
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# Browser security. Keep local origins explicit; production must use its HTTPS frontend origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
# Set REFRESH_TOKEN_SECURE=true only when the API is served via HTTPS.
REFRESH_TOKEN_SECURE=false
REFRESH_TOKEN_SAME_SITE=Lax

# Multipart uploads. Keep this aligned with EbookPdfValidator's 100MB limit.
APP_MULTIPART_MAX_FILE_SIZE=100MB
APP_MULTIPART_MAX_REQUEST_SIZE=110MB

# Cloudinary is optional for the standard demo. Fill these only to demo image upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# RAG is optional and disabled for the standard demo. Enable it only after the RAG
# service is running and reachable from this application.
RAG_ENABLED=false
RAG_SERVICE_URL=http://localhost:8000
RAG_INTERNAL_API_KEY=
RAG_CONNECT_TIMEOUT=3s
RAG_READ_TIMEOUT=30s
RAG_INGESTION_SYNC_FIXED_DELAY_MS=5000
RAG_INGESTION_SYNC_INITIAL_DELAY_MS=10000
RAG_INGESTION_SYNC_BATCH_SIZE=25
RAG_INGESTION_SYNC_MAX_POLL_FAILURES=5
RAG_INGESTION_SYNC_INITIAL_RETRY_DELAY=30s
RAG_INGESTION_SYNC_MAX_RETRY_DELAY=15m

# RAG service runtime. These values are consumed only when compose.rag.yaml is
# included. The Python service keeps its own rag-service/.env.example solely for
# running that service outside the repository-level Compose stack.
RAG_APP_ENV=development
RAG_APP_DEBUG=false
RAG_LOG_LEVEL=INFO
RAG_LOG_JSON=false
RAG_ENABLE_API_DOCS=false
RAG_POSTGRES_DB=rag_db
RAG_POSTGRES_USER=rag_user
RAG_POSTGRES_PASSWORD=change-me-rag-postgres
RAG_POSTGRES_PORT=5433
RAG_REDIS_PORT=6380
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=rag_chunks
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=3072
EMBEDDING_FALLBACK_MODEL=gemini-embedding-001
EMBEDDING_VERSION=gemini-embedding-2-3072-v1
EMBEDDING_TEXT_POLICY=gemini_search_title_text_v1
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_RETRIES=5
EMBEDDING_RETRY_BASE_DELAY_SECONDS=2
EMBEDDING_RETRY_MAX_DELAY_SECONDS=60
EMBEDDING_RETRY_JITTER_SECONDS=0.5
EMBEDDING_DISTANCE_METRIC=Cosine
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30
CHUNK_SIZE=512
CHUNK_OVERLAP=64
# Keep v1 until chapter-aware v2 passes the real-book comparison.
CHUNKING_STRATEGY_VERSION=v1
MAX_CHUNKS_PER_DOCUMENT=1000
MAX_PDF_PAGES=3000
PDF_TEXT_SAMPLE_PAGES=5
PDF_MIN_AVG_TEXT_CHARS=50
MAX_UPLOAD_SIZE_MB=100
INGESTION_ALLOWED_EXTENSIONS=[".pdf"]
PDF_PARSER=pymupdf4llm
PDF_CLEANING_VERSION=pdf-clean-v1.0.0
PDF_CLEAN_NORMALIZE_UNICODE=true
PDF_CLEAN_COLLAPSE_SPACES=true
PDF_CLEAN_MAX_BLANK_LINES=2
PDF_CLEAN_HEADER_FOOTER_DETECTION_ENABLED=true
PDF_CLEAN_HEADER_FOOTER_TOP_LINES=3
PDF_CLEAN_HEADER_FOOTER_BOTTOM_LINES=3
PDF_CLEAN_HEADER_FOOTER_MIN_REPEAT_RATIO=0.4
PDF_CLEAN_HEADER_FOOTER_REMOVAL_ENABLED=false
RETRIEVAL_TOP_K=10
RETRIEVAL_MODE=hybrid
KEYWORD_CANDIDATE_LIMIT=5000
HYBRID_CANDIDATE_MULTIPLIER=3
HYBRID_RRF_K=60
HYBRID_FAIL_OPEN=true
QUERY_REWRITE_MAX_QUERIES=2
CONTEXT_EXPANSION_WINDOW=1
GRAPH_MAX_HOPS=2
GRAPH_EDGE_LIMIT=5000
GRAPH_RRF_WEIGHT=0.15
GRAPH_LLM_MAX_TOKENS=8192
RERANKER_TOP_K=3
ANSWER_RETRIEVAL_TOP_K=6
ANSWER_SCORE_THRESHOLD=0.60
ANSWER_MAX_CONTEXT_CHARS=12000
HYBRID_VECTOR_WEIGHT=0.7
HYBRID_KEYWORD_WEIGHT=0.3
RAG_ARTIFACT_BUCKET=rag-artifacts
RAG_SOURCE_BUCKET=library-private
RAG_API_PORT=8000
SEAWEEDFS_S3_PORT=8333

# Ebook object storage is also optional. It is needed only for ebook upload/reader
# flows; the standard library demo starts without an S3-compatible service.
OBJECT_STORAGE_ENDPOINT=http://localhost:8333
# Local only. On VPS use an HTTPS domain such as https://storage.example.com.
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:8333
OBJECT_STORAGE_ACCESS_KEY=admin
OBJECT_STORAGE_SECRET_KEY=secret
OBJECT_STORAGE_REGION=us-east-1
LIBRARY_EBOOK_BUCKET=library-private
LIBRARY_TEMP_BUCKET=library-temp

# VNPAY Sandbox Payment Gateway
# Fill real sandbox credentials in .env only. Do not commit real values.
VNPAY_TMN_CODE=your-vnpay-terminal-code
VNPAY_HASH_SECRET=your-vnpay-hash-secret
VNPAY_ENABLED=true
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TRANSACTION_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return
VNPAY_IPN_URL=http://localhost:8080/api/payments/ipn/vnpay
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_ORDER_TYPE=other
VNPAY_LOCALE=vn
VNPAY_EXPIRE_MINUTES=15
VNPAY_REQUEST_TIMEOUT_MS=5000

# PgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me-pgadmin-password

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
