# Public HTTP entry point used while the project does not have a domain yet.
# __PUBLIC_HOST__ is replaced with the VPS IPv4 address by provision-nginx.sh.

limit_req_zone $binary_remote_addr zone=quanlythuvien_auth_limit:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name __PUBLIC_HOST__;
    server_tokens off;

    client_max_body_size 110m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    # Certbot webroot is prepared now so this same HTTP endpoint can later
    # validate either a domain certificate or a short-lived IP certificate.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    # Expose one minimal health endpoint for the CD gate. The remaining
    # Actuator surface and API documentation stay private on production.
    location = /healthz {
        proxy_pass http://127.0.0.1:8080/actuator/health;
        include /etc/nginx/snippets/quanlythuvien-proxy.conf;
    }

    location ~ ^/(swagger-ui(?:/|$)|swagger-ui\.html$|api-docs(?:/|$)|v3/api-docs(?:/|$)|actuator(?:/|$)) {
        return 404;
    }

    location = /api/auth/login {
        limit_req zone=quanlythuvien_auth_limit burst=5 nodelay;
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/snippets/quanlythuvien-proxy.conf;
    }

    location ~ ^/api/books/import-csv/[^/]+/events$ {
        proxy_pass http://127.0.0.1:8080;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 10m;
        include /etc/nginx/snippets/quanlythuvien-proxy.conf;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_read_timeout 60s;
        proxy_send_timeout 120s;
        include /etc/nginx/snippets/quanlythuvien-proxy.conf;
    }
}
