limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name api.library.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.library.example.com;

    ssl_certificate /etc/letsencrypt/live/api.library.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.library.example.com/privkey.pem;

    client_max_body_size 110m;

    location ~ ^/(swagger-ui|api-docs|v3/api-docs|actuator/(prometheus|metrics)) {
        deny all;
    }

    location = /api/auth/login {
        limit_req zone=auth_limit burst=5 nodelay;
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/snippets/quanlythuvien-proxy.conf;
    }

    location ~ ^/api/books/import-csv/[^/]+/events$ {
        proxy_pass http://127.0.0.1:8080;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 10m;
        include /etc/nginx/snippets/quanlythuvien-proxy.conf;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_read_timeout 60s;
        proxy_send_timeout 120s;
        include /etc/nginx/snippets/quanlythuvien-proxy.conf;
    }
}
