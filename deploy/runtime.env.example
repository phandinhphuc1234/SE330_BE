# Copy to $HOME/.config/quanlythuvien/backend.env on the VPS.
# Replace every CHANGE_ME value. Keep the real file mode at 600.

LIBRARY_APP_PORT=8080

POSTGRES_DB=library
POSTGRES_USER=library_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

JWT_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
EBOOK_READING_SESSION_SECRET=CHANGE_ME_DIFFERENT_RANDOM_SECRET

CORS_ALLOWED_ORIGINS=https://library.example.com
CORS_ALLOW_CREDENTIALS=true
REFRESH_TOKEN_SECURE=true
REFRESH_TOKEN_SAME_SITE=Lax
APP_PASSWORD_RESET_BASE_URL=https://library.example.com/reset-password
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

RESEND_API_KEY=
APP_TIME_ZONE=Asia/Ho_Chi_Minh
MAIL_FROM=no-reply@library.example.com
MANAGEMENT_HEALTH_MAIL_ENABLED=false
SWAGGER_ENABLED=false
# Production enables the durable worker; V44 quarantines incomplete legacy rows.
NOTIFICATION_DELIVERY_ENABLED=true
NOTIFICATION_DELIVERY_BATCH_SIZE=10
NOTIFICATION_DELIVERY_POLL_DELAY_MS=5000
NOTIFICATION_DELIVERY_INITIAL_DELAY_MS=10000
NOTIFICATION_DELIVERY_LOCK_TIMEOUT=2m
NOTIFICATION_DELIVERY_INITIAL_RETRY_DELAY=30s
NOTIFICATION_DELIVERY_MAX_RETRY_DELAY=30m
NOTIFICATION_DELIVERY_CONNECT_TIMEOUT=5s
NOTIFICATION_DELIVERY_READ_TIMEOUT=15s
RESEND_WEBHOOK_ENABLED=false
RESEND_WEBHOOK_SIGNING_SECRET=
RESEND_WEBHOOK_MAX_PAYLOAD_BYTES=262144

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BOOK_IMAGE_CLEANUP_ENABLED=false

RAG_ENABLED=false
RAG_SERVICE_URL=http://rag-api:8000
RAG_INTERNAL_API_KEY=
RAG_POSTGRES_DB=rag_db
RAG_POSTGRES_USER=rag_app
RAG_POSTGRES_PASSWORD=CHANGE_ME_STRONG_RAG_POSTGRES_PASSWORD
RAG_REDIS_PASSWORD=CHANGE_ME_STRONG_RAG_REDIS_PASSWORD
RAG_LOG_LEVEL=INFO
RAG_LOG_JSON=true

QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=rag_chunks
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=3072
EMBEDDING_FALLBACK_MODEL=gemini-embedding-001
EMBEDDING_VERSION=gemini-embedding-2-3072-v1
EMBEDDING_TEXT_POLICY=gemini_search_title_text_v1
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_RETRIES=5
EMBEDDING_RETRY_BASE_DELAY_SECONDS=2
EMBEDDING_RETRY_MAX_DELAY_SECONDS=60
EMBEDDING_RETRY_JITTER_SECONDS=0.5
EMBEDDING_DISTANCE_METRIC=Cosine

LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_CHUNKS_PER_DOCUMENT=1000
MAX_PDF_PAGES=3000
PDF_TEXT_SAMPLE_PAGES=5
PDF_MIN_AVG_TEXT_CHARS=50
MAX_UPLOAD_SIZE_MB=100
INGESTION_ALLOWED_EXTENSIONS=[".pdf"]
PDF_PARSER=pymupdf4llm
PDF_CLEANING_VERSION=pdf-clean-v1.0.0
PDF_CLEAN_NORMALIZE_UNICODE=true
PDF_CLEAN_COLLAPSE_SPACES=true
PDF_CLEAN_MAX_BLANK_LINES=2
PDF_CLEAN_HEADER_FOOTER_DETECTION_ENABLED=true
PDF_CLEAN_HEADER_FOOTER_TOP_LINES=3
PDF_CLEAN_HEADER_FOOTER_BOTTOM_LINES=3
PDF_CLEAN_HEADER_FOOTER_MIN_REPEAT_RATIO=0.4
PDF_CLEAN_HEADER_FOOTER_REMOVAL_ENABLED=false
RETRIEVAL_TOP_K=10
RERANKER_TOP_K=3
HYBRID_VECTOR_WEIGHT=0.7
HYBRID_KEYWORD_WEIGHT=0.3

OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:8333
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://storage.library.example.com
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME_IF_EBOOK_IS_ENABLED
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME_IF_EBOOK_IS_ENABLED
OBJECT_STORAGE_REGION=us-east-1
LIBRARY_EBOOK_BUCKET=library-private
LIBRARY_TEMP_BUCKET=library-temp
RAG_ARTIFACT_BUCKET=rag-artifacts

VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TRANSACTION_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=https://library.example.com/payment/vnpay-return
VNPAY_IPN_URL=https://api.library.example.com/api/payments/ipn/vnpay
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_ORDER_TYPE=other
VNPAY_LOCALE=vn
VNPAY_EXPIRE_MINUTES=15
VNPAY_REQUEST_TIMEOUT_MS=5000

APP_MULTIPART_MAX_FILE_SIZE=100MB
APP_MULTIPART_MAX_REQUEST_SIZE=110MB

# Tune these to the VPS size. Defaults fit a VPS with roughly 3 GB RAM or more.
APP_MEMORY_LIMIT=1024m
APP_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=768m
POSTGRES_CPU_LIMIT=1.0
REDIS_MEMORY_LIMIT=256m
REDIS_CPU_LIMIT=0.5
RAG_API_MEMORY_LIMIT=768m
RAG_API_CPU_LIMIT=1.0
RAG_WORKER_MEMORY_LIMIT=1024m
RAG_WORKER_CPU_LIMIT=1.0
RAG_WORKER_CONCURRENCY=1
RAG_POSTGRES_MEMORY_LIMIT=512m
RAG_POSTGRES_CPU_LIMIT=0.75
RAG_REDIS_MEMORY_LIMIT=192m
RAG_REDIS_CPU_LIMIT=0.25
QDRANT_MEMORY_LIMIT=768m
QDRANT_CPU_LIMIT=1.0
SEAWEEDFS_MEMORY_LIMIT=512m
SEAWEEDFS_CPU_LIMIT=0.75

# Container tags can be pinned to digests later without changing the pipeline.
POSTGRES_IMAGE=postgres:16
REDIS_IMAGE=redis:7
RAG_POSTGRES_IMAGE=postgres:16-alpine
RAG_REDIS_IMAGE=redis:7-alpine
QDRANT_IMAGE=qdrant/qdrant:v1.13.4
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:3.85
AWS_CLI_IMAGE=amazon/aws-cli:2.17.57
