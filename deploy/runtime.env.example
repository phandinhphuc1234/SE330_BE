# Copy to $HOME/.config/quanlythuvien/backend.env on the VPS.
# Replace every CHANGE_ME value. Keep the real file mode at 600.

LIBRARY_APP_PORT=8080

POSTGRES_DB=library
POSTGRES_USER=library_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

JWT_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
EBOOK_READING_SESSION_SECRET=CHANGE_ME_DIFFERENT_RANDOM_SECRET

CORS_ALLOWED_ORIGINS=https://library.example.com
CORS_ALLOW_CREDENTIALS=true
REFRESH_TOKEN_SECURE=true
REFRESH_TOKEN_SAME_SITE=Lax
APP_VERIFICATION_BASE_URL=https://api.library.example.com
APP_PASSWORD_RESET_BASE_URL=https://library.example.com/reset-password
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

RESEND_API_KEY=
MAIL_FROM=no-reply@library.example.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BOOK_IMAGE_CLEANUP_ENABLED=false

RAG_ENABLED=false
RAG_SERVICE_URL=http://127.0.0.1:8000
RAG_INTERNAL_API_KEY=

OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:8333
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://storage.library.example.com
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME_IF_EBOOK_IS_ENABLED
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME_IF_EBOOK_IS_ENABLED
OBJECT_STORAGE_REGION=us-east-1
LIBRARY_EBOOK_BUCKET=library-private
LIBRARY_TEMP_BUCKET=library-temp

VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TRANSACTION_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=https://library.example.com/payment/vnpay-return
VNPAY_IPN_URL=https://api.library.example.com/api/payments/ipn/vnpay
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_ORDER_TYPE=other
VNPAY_LOCALE=vn
VNPAY_EXPIRE_MINUTES=15
VNPAY_REQUEST_TIMEOUT_MS=5000

APP_MULTIPART_MAX_FILE_SIZE=100MB
APP_MULTIPART_MAX_REQUEST_SIZE=110MB

# Tune these to the VPS size. Defaults fit a VPS with roughly 3 GB RAM or more.
APP_MEMORY_LIMIT=1024m
APP_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=768m
POSTGRES_CPU_LIMIT=1.0
REDIS_MEMORY_LIMIT=256m
REDIS_CPU_LIMIT=0.5

# Container tags can be pinned to digests later without changing the pipeline.
POSTGRES_IMAGE=postgres:16
REDIS_IMAGE=redis:7
